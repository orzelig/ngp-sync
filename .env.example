# Copy to .env and fill in. .env is gitignored — secrets never get committed.

# --- domains (prod profile / Caddy) ---
DOMAIN_SYNC=sync.ngp.one
DOMAIN_ID=id.ngp.one
IDENTITY_BASE_URL=https://id.ngp.one
# For laptop-only testing leave IDENTITY_BASE_URL as http://localhost:8300

# --- go-sync ---
# Pin to a commit you've tested (master as of 2026-11-04):
GO_SYNC_REF=31ad41afd4d33e3fd7434b4cc54c17c2f2f6f9c0

# --- identity service ---
# From your X developer app (developer.x.com → your app → OAuth 2.0,
# app type "Web App" / confidential; callback URL: https://id.ngp.one/callback):
X_CLIENT_ID=
X_CLIENT_SECRET=

# Shared secret: identity service signs sync JWTs with it, go-sync (Phase 2)
# verifies with it. Generate: openssl rand -hex 32
SYNC_JWT_SECRET=
